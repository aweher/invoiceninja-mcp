# Root URL of your Invoice Ninja instance (no /api/v1 needed)
INVOICENINJA_URL=https://invoicing.co
# Settings > Account Management > API Tokens
INVOICENINJA_API_TOKEN=
# Set to true to expose create/update/bulk-action tools
INVOICENINJA_ENABLE_WRITES=false
INVOICENINJA_TIMEOUT=30
INVOICENINJA_VERIFY_SSL=true
